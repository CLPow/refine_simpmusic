<?xml version="1.0" encoding="utf-8"?>
<!--
  previewImage of the Now Playing widget for launchers that do not read previewLayout: the 4x2
  form in flat shapes, matching widget_preview_turntable. Header band with cover, two text lines,
  thumbs-up and play, then the strip of five recently played covers.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wp_strip" />
            <corners android:radius="24dp" />
            <size android:width="300dp" android:height="170dp" />
        </shape>
    </item>
    <item android:bottom="78dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/wp_background" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
    <!-- cover -->
    <item android:left="16dp" android:top="16dp" android:width="60dp" android:height="60dp" android:gravity="top|start">
        <shape><solid android:color="@color/wp_art" /><corners android:radius="16dp" /></shape>
    </item>
    <!-- title and artist -->
    <item android:left="92dp" android:top="28dp" android:width="70dp" android:height="12dp" android:gravity="top|start">
        <shape><solid android:color="@color/wp_on_surface" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:left="92dp" android:top="48dp" android:width="48dp" android:height="10dp" android:gravity="top|start">
        <shape><solid android:color="@color/wp_on_surface_variant" /><corners android:radius="5dp" /></shape>
    </item>
    <!-- thumbs-up and play -->
    <item android:right="84dp" android:top="16dp" android:width="48dp" android:height="60dp" android:gravity="top|end">
        <shape><solid android:color="@color/wp_tertiary_container" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:right="16dp" android:top="16dp" android:width="60dp" android:height="60dp" android:gravity="top|end">
        <shape><solid android:color="@color/wp_primary" /><corners android:radius="16dp" /></shape>
    </item>
    <!-- recently played -->
    <item android:left="14dp" android:bottom="11dp" android:width="44dp" android:height="56dp" android:gravity="bottom|start">
        <shape><solid android:color="@color/wp_art" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:left="72dp" android:bottom="11dp" android:width="44dp" android:height="56dp" android:gravity="bottom|start">
        <shape><solid android:color="@color/wp_art" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:bottom="11dp" android:width="44dp" android:height="56dp" android:gravity="bottom|center_horizontal">
        <shape><solid android:color="@color/wp_art" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:right="72dp" android:bottom="11dp" android:width="44dp" android:height="56dp" android:gravity="bottom|end">
        <shape><solid android:color="@color/wp_art" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:right="14dp" android:bottom="11dp" android:width="44dp" android:height="56dp" android:gravity="bottom|end">
        <shape><solid android:color="@color/wp_art" /><corners android:radius="14dp" /></shape>
    </item>
</layer-list>
