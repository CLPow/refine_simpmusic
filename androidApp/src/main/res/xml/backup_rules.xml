<?xml version="1.0" encoding="utf-8"?><!--
    Auto Backup is on for settings that are safe to restore, but DataStore
    holds the YouTube session cookie and other credentials. Never include the
    datastore tree — restoring a cookie onto another device (or a cloud
    snapshot) leaks the account session.
-->
<full-backup-content>
    <!-- Settings without secrets can restore; secrets live in DataStore and stay out. -->
    <exclude domain="file" path="datastore/"/>
    <exclude domain="file" path="datastore/."/>
    <exclude domain="database" path="."/>
</full-backup-content>
